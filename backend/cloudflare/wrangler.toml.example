name = "lexpdf-api"
main = "src/index.ts"
compatibility_date = "2026-09-05"
workers_dev = true

# Copy to wrangler.toml only after linking the Cloudflare account.
# Never commit API tokens, Supabase secret keys, OAuth secrets or R2 credentials.

[[r2_buckets]]
binding = "DOCUMENTS"
bucket_name = "lexpdf-files"

[[queues.producers]]
binding = "SYNC_QUEUE"
queue = "lexpdf-sync"

[[queues.consumers]]
queue = "lexpdf-sync"
max_batch_size = 10
max_batch_timeout = 5
max_retries = 3
dead_letter_queue = "lexpdf-sync-dlq"
retry_delay = 30

[vars]
ENVIRONMENT = "development"
SUPABASE_URL = "https://ibffselezupggrovfruz.supabase.co"
MAX_UPLOAD_BYTES = "262144000"

# Configure outside git:
# wrangler secret put SUPABASE_PUBLISHABLE_KEY
# wrangler secret put SUPABASE_SECRET_KEY
#
# SUPABASE_PUBLISHABLE_KEY authenticates end-user JWT validation calls.
# SUPABASE_SECRET_KEY is server-only and is used by Queue consumers to persist
# backend_events. Never expose it to Flutter or any other client application.
